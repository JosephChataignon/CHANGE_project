# folder to save logs in on this machine
LOGS_FOLDER="/path/to/logs"
# folder to save neural network models after training
SAVED_MODELS_DIR="/path/to/saved_models"

# file containing the huggingFace access token
HUGGINGFACE_TOKEN_FILE="/path/to/.hf_token"

# Research storage
DATA_STORAGE="/path/to/dataset"

# Ollama server URL
OLLAMA_HOST=https://my-ollama-server.com

# For fine-tuning tasks in embeddings_finetune.py
EMBEDDING_MODEL="nvidia/llama-embed-nemotron-8b"
# For fine-tuning tasks, loading more or less training data 
SAMPLE_SCALE=0.0001
